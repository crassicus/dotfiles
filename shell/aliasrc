# General shortcuts

alias \
	cp="cp -iv" \
	mv="mv -iv" \
	ls="eza" \
	lb="lsblk" \
	cl="clear" \
	t="touch" \
	a="cd .." \
	c="cd" \
	b="cd \$ROOT" \
	k="cd \$OLDPWD" \
	tm="cd /tmp" \
  dc="cd ~/Documents" \
  dw="cd ~/Downloads" \
	dt="cd ~/.dotfiles" \
	ds="cd ~/.dotfiles && v run.sh" \
	zh="v ~/.zsh_history" \
  y="yazi" \
	ft="foot & disown; exit" \
	brave="brave-browser-stable & disown; exit" \
	dv="c $DC/development/development" \
	bd="c $DC/development/development/building" \
	bk="c $DC/development/development/back" \
	fr="c $DC/development/development/front" \
	lr="ln -s /home/disk/rust/info/cargo .cargo"

alias \
  z="zathura-full" \
	gk="gpg --list-keys --keyid-format long" \
  nf="neofetch" \
	sdn="sudo shutdown -h now" \
	rb="sudo reboot" \


# Git
alias \
  gs="git status" \
  gb="git branch" \
  gl="git log --all --graph" \
  gw="git switch" \
  go="git checkout" \
  gc="git clone" \
  gx='git commit -m "|"' \
  gp="git pull" \
  gh="git push" \
  ga="git add" \
  gd="git diff" \
  gr="git remote" \
  gt="git stash" \
  gm="git merge" \
  gi="git init"

# Rust
alias \
	ci="cargo init" \
	cx="cargo run" \
	ca="cargo add" \
  ct="cargo test" \
	cr="cargo build --release" \
	cw="cargo watch -x clippy -x test -x run" \
